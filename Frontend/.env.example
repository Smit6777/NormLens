# NormLens Frontend Environment Configuration
# Because this is a vanilla HTML/JS app, this file serves as documentation.
# For production deployment, update the `API_BASE_URL` variable in `app.js` to point to your live backend domain.

# Example for local development:
# API_BASE_URL = 'http://127.0.0.1:8000/api/v1'

# Example for production deployment (e.g. Render, Heroku, AWS):
# API_BASE_URL = 'https://api.normlens.yourdomain.com/api/v1'
