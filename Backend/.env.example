# Copy to .env and adjust as needed. Never commit a real .env file.

# --- Application ---
APP_NAME=BIS Standard Recommendation & Compliance Auditor
APP_ENV=development
LOG_LEVEL=INFO

# --- Data layer (knowledge layer JSON files, relative to backend/) ---
DATA_DIR=./data
BIS_METADATA_FILE=bis_metadata.json
BIS_COMPLIANCE_FILE=bis_compliance.json
QCO_MAPPING_FILE=qco_mapping.json
NORMATIVE_GRAPH_FILE=normative_graph.json
SOURCES_FILE=sources.json

# --- Embeddings / vector search (used starting Phase 2) ---
EMBEDDING_MODEL_NAME=all-mpnet-base-v2
VECTOR_INDEX_DIR=./data/index
TOP_K_CANDIDATES=10
MIN_MATCH_SCORE=0.3

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.txt

# --- Security & Auth ---
API_KEY=test-api-key
ADMIN_API_KEY=admin-api-key
RATE_LIMIT=100/hour

# --- API ---
API_V1_PREFIX=/api/v1
